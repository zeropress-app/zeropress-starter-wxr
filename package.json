{
  "name": "zeropress-starter-wxr",
  "version": "0.7.9",
  "description": "Try ZeroPress with a WordPress WXR export and your existing WordPress resources",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run import && zeropress-build ./theme --data ./.zeropress-wxr/zeropress-preview-data.json --public-dir ./public --out ./dist --empty-out-dir",
    "postbuild": "npm run search:replace-with-pagefind",
    "search:replace-with-pagefind": "node scripts/replace-search-with-pagefind.mjs",
    "dist:prettify": "node scripts/prettify.mjs",
    "dist:minify": "node scripts/minify.mjs",
    "dist:preview": "wrangler dev --local",
    "preview": "npm run build && wrangler dev --local",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "test": "node --test test/*.test.mjs",
    "check": "npm run format:wrangler:check && npm test && npm run deploy:dry-run",
    "format:wrangler": "node scripts/format-wrangler.mjs",
    "format:wrangler:check": "node scripts/format-wrangler.mjs --check",
    "import": "zeropress-wxr-import --input ./wordpress-export.xml --base ./wxr-import-base.json --override ./wxr-import-base.override.json --output ./.zeropress-wxr/zeropress-preview-data.json"
  },
  "dependencies": {
    "@zeropress/build": "^0.7.9",
    "@zeropress/wxr-import": "^0.7.9"
  },
  "devDependencies": {
    "jsonc-parser": "3.3.1",
    "pagefind": "1.5.2",
    "wrangler": "^4.153.0"
  }
}
